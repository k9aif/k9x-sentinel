# K9X Sentinel — environment. Copy to .env; never commit .env.

# Ollama host serving the analysis model and Granite Guardian
OLLAMA_BASE_URL=http://localhost:11434
SENTINEL_MODEL=qwen3.8:27b
SENTINEL_GUARDIAN_MODEL=granite4.1-guardian:8b

# Kafka / Redpanda: HIL requests go out on hil.requests.framework_security_updates,
# decisions come back on hil.replies.framework_security_updates (k9x-hil).
# Empty = no HIL (findings stay in Sentinel's own UI only).
KAFKA_BROKER=localhost:9092

# What goes into a HIL case. "minimal" = finding number, verdict, severity and a
# link to this UI; "full" = the whole analysis. Keep minimal while any k9x-hil
# user (a public demo login included) can read every task.
SENTINEL_HIL_DETAIL=minimal
# k9x-hil users whose decisions Sentinel acts on (comma-separated emails).
# Any other user's decision is ignored and the case is raised again.
# NOTE: only effective once k9x-hil records the actor from the login itself.
SENTINEL_HIL_APPROVERS=ravinatarajan@k9x.ai
# Link put in HIL cases (this UI as reviewers reach it)
SENTINEL_PUBLIC_URL=http://localhost:8114

# Daily run, local time of the container (TZ)
SENTINEL_RUN_AT=06:00
TZ=America/New_York

# Approved findings -> GitHub. dry_run records what would be created;
# live creates a private draft security advisory (technique gaps) or an issue
# (public dependency CVEs) on SENTINEL_GITHUB_REPO.
# Token: fine-grained, that repo only, "Administration: read" is NOT needed;
# needs "Repository security advisories: write" and "Issues: write".
SENTINEL_GITHUB_MODE=dry_run
SENTINEL_GITHUB_REPO=k9aif/k9-aif-framework
SENTINEL_GITHUB_TOKEN=

# Capability catalog. Empty = the one shipped in the installed k9-aif
# (>= 1.14.1), else the framework's main branch on GitHub.
SENTINEL_CATALOG_PATH=

# Web UI (private: findings describe unpatched gaps — never expose publicly)
SENTINEL_PORT=8114
SENTINEL_USER=admin
SENTINEL_PASSWORD=
# Optional read-only demo login, shown on the sign-in page. Empty password = off.
# A viewer never sees an open gap: gaps and partial gaps show as "under private
# review"; no Run now, no audit export.
SENTINEL_DEMO_USER=demo
SENTINEL_DEMO_PASSWORD=
# Signs the sign-in session cookie. Empty = random per start (everyone signs in
# again after a restart). Changing SENTINEL_PASSWORD always ends all sessions.
SENTINEL_SESSION_SECRET=

# ── Database ──
# sqlite (default): a local file, zero setup — fine for trying Sentinel out.
# postgres: findings, run history, the append-only audit trail and open HIL
#   cases in PostgreSQL (schema SENTINEL_DB_SCHEMA, created on first start).
#   Use this for any real deployment: auditable, backed up with the rest.
SENTINEL_DB=sqlite
SENTINEL_DB_PATH=./runtime/sentinel.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=k9x
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
SENTINEL_DB_SCHEMA=k9sentinel

# A HIL case waiting longer than this many days is flagged overdue
SENTINEL_HIL_OVERDUE_DAYS=7

# Framework governance mode (production = governance must be real)
K9_ENV=production
